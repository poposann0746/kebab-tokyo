<% content_for :title, "ユーザー詳細 | 管理画面" %>

<div class="mb-4">
  <%= link_to admin_users_path, class: "inline-flex items-center gap-1 text-sm text-amber-800 hover:text-amber-900 font-bold" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    <span>ユーザー一覧へ戻る</span>
  <% end %>
</div>

<section class="bg-stone-900 text-amber-50 rounded-2xl shadow-lg p-6 mb-6">
  <h1 class="text-2xl font-black flex items-center gap-2">
    <span>👤</span><span><%= @user.display_name %></span>
  </h1>
  <p class="text-sm text-amber-100/80 mt-1"><%= @user.email %></p>
</section>

<section class="bg-white rounded-2xl shadow-lg border border-stone-200 p-5 mb-6">
  <h2 class="font-bold text-stone-800 flex items-center gap-2 mb-3">
    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-100">📇</span>
    <span>基本情報</span>
  </h2>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
    <div>
      <dt class="font-bold text-stone-500">ID</dt>
      <dd class="text-stone-800"><%= @user.id %></dd>
    </div>
    <div>
      <dt class="font-bold text-stone-500">メールアドレス</dt>
      <dd class="text-stone-800 break-all"><%= @user.email %></dd>
    </div>
    <div>
      <dt class="font-bold text-stone-500">ニックネーム</dt>
      <dd class="text-stone-800"><%= @user.display_name %></dd>
    </div>
    <div>
      <dt class="font-bold text-stone-500">登録日</dt>
      <dd class="text-stone-800"><%= l(@user.created_at, format: :long) rescue @user.created_at.strftime("%Y-%m-%d %H:%M") %></dd>
    </div>
    <div>
      <dt class="font-bold text-stone-500">レビュー数</dt>
      <dd class="text-stone-800 font-bold"><%= @reviews.size %></dd>
    </div>
  </dl>
</section>

<section class="bg-white rounded-2xl shadow-lg border border-stone-200 p-5">
  <h2 class="font-bold text-stone-800 flex items-center gap-2 mb-3">
    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-100">📝</span>
    <span>投稿レビュー</span>
  </h2>

  <% if @reviews.any? %>
    <ul class="divide-y divide-stone-100">
      <% @reviews.each do |review| %>
        <li class="py-3 flex items-start gap-3">
          <span class="inline-flex shrink-0 items-center justify-center min-w-12 h-12 rounded-full bg-stone-900/80 backdrop-blur-sm text-amber-50 font-black text-sm px-2">
            <%= review.overall_score %>
          </span>
          <div class="flex-1 min-w-0">
            <div class="font-bold text-stone-800 truncate"><%= review.shop&.name || "（店舗削除済み）" %></div>
            <div class="text-sm text-stone-600 line-clamp-2 mt-0.5"><%= review.comment.presence || "（コメントなし）" %></div>
            <div class="text-xs text-stone-400 mt-1"><%= l(review.created_at, format: :long) rescue review.created_at.strftime("%Y-%m-%d") %></div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-stone-500 py-4 text-center">投稿されたレビューはありません</p>
  <% end %>
</section>
