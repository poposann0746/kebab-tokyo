<ul class="divide-y divide-stone-100">
  <li>
    <%= link_to admin_root_path,
          class: "flex items-center gap-3 px-4 py-3 hover:bg-amber-50 #{'bg-amber-50' if current_page?(admin_root_path)}" do %>
      <span class="text-lg">📊</span>
      <span class="flex-1 font-bold text-stone-800">ダッシュボード</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    <% end %>
  </li>
  <li>
    <%= link_to admin_users_path,
          class: "flex items-center gap-3 px-4 py-3 hover:bg-amber-50 #{'bg-amber-50' if controller_name == 'users'}" do %>
      <span class="text-lg">👥</span>
      <span class="flex-1 font-bold text-stone-800">ユーザー管理</span>
      <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    <% end %>
  </li>
  <li>
    <div class="flex items-center gap-3 px-4 py-3 text-stone-400 cursor-not-allowed">
      <span class="text-lg">🚩</span>
      <span class="flex-1 font-bold">通報対応</span>
      <span class="text-xs font-bold bg-stone-100 text-stone-500 rounded-full px-2 py-0.5">準備中</span>
    </div>
  </li>
  <li>
    <div class="flex items-center gap-3 px-4 py-3 text-stone-400 cursor-not-allowed">
      <span class="text-lg">🏪</span>
      <span class="flex-1 font-bold">店舗管理</span>
      <span class="text-xs font-bold bg-stone-100 text-stone-500 rounded-full px-2 py-0.5">準備中</span>
    </div>
  </li>
</ul>
