<header class="bg-stone-900 text-amber-50 sticky top-0 z-50 shadow-md">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <%= link_to admin_root_path, class: "flex items-center gap-2" do %>
      <span class="text-xl">🛠️</span>
      <span class="font-black tracking-wide">Kebab TOKYO 管理画面</span>
    <% end %>

    <% if admin_signed_in? %>
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline text-sm text-amber-100/80"><%= current_admin.email %></span>
        <%= button_to destroy_admin_session_path,
              method: :delete,
              class: "text-sm font-bold text-amber-900 bg-amber-100 hover:bg-amber-200 rounded-xl px-3 py-1.5 border-2 border-amber-300" do %>
          ログアウト
        <% end %>
      </div>
    <% end %>
  </div>
</header>
