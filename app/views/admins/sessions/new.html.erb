<div class="bg-white rounded-2xl shadow-2xl border border-stone-200 p-6 sm:p-8">
  <div class="text-center mb-6">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-amber-100 mb-3">
      <span class="text-3xl">🛠️</span>
    </div>
    <h1 class="text-xl font-black text-stone-800">管理画面ログイン</h1>
    <p class="text-sm text-stone-500 mt-1">Kebab TOKYO 運用管理</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-bold text-stone-700 mb-1" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "w-full px-4 py-3 rounded-xl border-2 border-stone-200 bg-amber-50 focus:border-amber-400 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-bold text-stone-700 mb-1" %>
      <%= f.password_field :password,
            autocomplete: "current-password",
            class: "w-full px-4 py-3 rounded-xl border-2 border-stone-200 bg-amber-50 focus:border-amber-400 focus:outline-none" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-stone-600">
        <%= f.check_box :remember_me, class: "rounded border-stone-300" %>
        <span>ログイン状態を保持する</span>
      </label>
    <% end %>

    <%= f.submit "ログイン",
          class: "w-full rounded-2xl font-black text-amber-900 bg-amber-100 border-2 border-amber-800 hover:bg-amber-800 hover:text-white transition-colors py-3 cursor-pointer" %>
  <% end %>

  <% if devise_mapping.recoverable? %>
    <div class="mt-4 text-center text-sm">
      <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), class: "text-amber-700 hover:underline" %>
    </div>
  <% end %>
</div>
